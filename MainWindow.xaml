<Window x:Class="ImageToolkit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ImageLab" 
        Height="750" 
        Width="1100"
        MinHeight="600" 
        MinWidth="900"
        Top="100"
        Left="100"
        WindowStyle="None"
        AllowsTransparency="True"
        Icon="app.ico"
        Background="#1E1E1E">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" 
                      GlassFrameThickness="0" 
                      CornerRadius="0" 
                      ResizeBorderThickness="8"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1C97EA"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#3F3F46"/>
                    <Setter Property="Foreground" Value="#6B6B6B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#3F3F46"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#52525B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Title Bar Button Style -->
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3F3F46"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Close Button Style -->
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern GroupBox Style -->
        <Style x:Key="ModernGroupBox" TargetType="GroupBox">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" 
                                    Background="#2D2D30" 
                                    CornerRadius="4,4,0,0"
                                    Padding="10,5">
                                <ContentPresenter ContentSource="Header"/>
                            </Border>
                            <Border Grid.Row="1" 
                                    Background="#252526" 
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="0,0,4,4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#3F3F46"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#007ACC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>

        <!-- Modern Slider Style -->
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#007ACC"/>
        </Style>

        <!-- Modern ComboBox Style -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#3F3F46"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#007ACC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton 
                                Name="ToggleButton" 
                                Grid.Column="2" 
                                Focusable="false"
                                IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                ClickMode="Press"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border 
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" Margin="8,5"/>
                                                <Path 
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Data="M 0 0 L 4 4 L 8 0 Z"
                                                    Fill="#B0B0B0"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter 
                                Name="ContentSite"
                                IsHitTestVisible="False" 
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                Margin="8,5"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"/>
                            <Popup 
                                Name="Popup"
                                Placement="Bottom"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                AllowsTransparency="True" 
                                Focusable="False"
                                PopupAnimation="Slide">
                                <Grid 
                                    Name="DropDown"
                                    SnapsToDevicePixels="True"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border 
                                        Background="#2D2D30"
                                        BorderBrush="#007ACC"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Margin="0,2,0,0">
                                        <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border 
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#007ACC"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#007ACC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Custom ScrollBar Style -->
        <Style x:Key="ScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="#52525B" CornerRadius="3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="5"/>
                            <Track Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid>
                                    <Border Background="{TemplateBinding Background}" CornerRadius="5"/>
                                    <Track Name="PART_Track">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollBarThumb}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ScrollViewer Style -->
        <Style TargetType="{x:Type ScrollViewer}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollContentPresenter Grid.Column="0" Grid.Row="0"/>
                            <ScrollBar 
                                Name="PART_VerticalScrollBar"
                                Grid.Column="1"
                                Grid.Row="0"
                                Value="{TemplateBinding VerticalOffset}"
                                Maximum="{TemplateBinding ScrollableHeight}"
                                ViewportSize="{TemplateBinding ViewportHeight}"
                                Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                Margin="2,0,0,0"/>
                            <ScrollBar 
                                Name="PART_HorizontalScrollBar"
                                Orientation="Horizontal"
                                Grid.Column="0"
                                Grid.Row="1"
                                Value="{TemplateBinding HorizontalOffset}"
                                Maximum="{TemplateBinding ScrollableWidth}"
                                ViewportSize="{TemplateBinding ViewportWidth}"
                                Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                Margin="0,2,0,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Main -->
            <RowDefinition Height="30"/>   <!-- Status -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Image Source="app.ico" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ToolsHeaderText" Text="ImageLab" Foreground="#007ACC" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Pro" Foreground="White" FontSize="20" FontWeight="Bold" Margin="2,0,0,0"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="LanguageButton" Content="EN" Style="{StaticResource ModernButton}" Click="LanguageButton_Click" Width="50" Margin="0,0,10,0" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="─" Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="▢" Style="{StaticResource TitleBarButton}" Click="MaximizeButton_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="✕" Style="{StaticResource CloseButton}" Click="CloseButton_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="#252526" BorderBrush="#3F3F46" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <GroupBox x:Name="FileGroupBox" Header="File" Style="{StaticResource ModernGroupBox}" Margin="0,0,0,10">
                            <StackPanel>
                                <Button x:Name="SelectImageButton" Content="Select Image" Style="{StaticResource ModernButton}" Margin="0,0,0,8" Click="SelectImageButton_Click"/>
                                <Button x:Name="ClearImageButton" Content="Clear" Style="{StaticResource SecondaryButton}" Click="ClearImageButton_Click" IsEnabled="False"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox x:Name="ImageInfoGroupBox" Header="Information" Style="{StaticResource ModernGroupBox}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="FileNameText" Text="File: -" Foreground="White" Margin="0,0,0,5"/>
                                <TextBlock x:Name="ResolutionText" Text="Resolution: -" Foreground="White" Margin="0,0,0,5"/>
                                <TextBlock x:Name="FileSizeText" Text="Size: -" Foreground="White"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox x:Name="ResizeGroupBox" Header="Resize" Style="{StaticResource ModernGroupBox}" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                        <TextBlock x:Name="WidthLabel" Text="Width" Foreground="#858585" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox x:Name="ResizeWidthTextBox" Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                        <TextBlock x:Name="HeightLabel" Text="Height" Foreground="#858585" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox x:Name="ResizeHeightTextBox" Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>
                                </Grid>
                                <CheckBox x:Name="KeepAspectRatioCheckBox" Content="Keep Aspect Ratio" IsChecked="True" Margin="0,0,0,10"/>
                                <Button x:Name="ResizeButton" Content="Resize and Save" Style="{StaticResource ModernButton}" Click="ResizeButton_Click" IsEnabled="False"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox x:Name="EnhancementGroupBox" Header="Enhancement" Style="{StaticResource ModernGroupBox}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="SharpnessLabel" Text="Sharpness" Foreground="#858585" FontSize="11" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                                    <Slider x:Name="SharpnessSlider" Minimum="0" Maximum="100" Value="50" ValueChanged="SharpnessSlider_ValueChanged"/>
                                    <TextBlock x:Name="SharpnessValueText" Grid.Column="1" Text="50" Foreground="#007ACC" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <TextBlock x:Name="ContrastLabel" Text="Contrast" Foreground="#858585" FontSize="11" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                                    <Slider x:Name="ContrastSlider" Minimum="-100" Maximum="100" Value="0" ValueChanged="ContrastSlider_ValueChanged"/>
                                    <TextBlock x:Name="ContrastValueText" Grid.Column="1" Text="0" Foreground="#007ACC" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <TextBlock x:Name="NoiseReductionLabel" Text="Noise Reduction" Foreground="#858585" FontSize="11" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                                    <Slider x:Name="NoiseReductionSlider" Minimum="0" Maximum="10" Value="2" ValueChanged="NoiseReductionSlider_ValueChanged"/>
                                    <TextBlock x:Name="NoiseReductionValueText" Grid.Column="1" Text="2" Foreground="#007ACC" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <TextBlock x:Name="UpscaleLabel" Text="AI Upscale" Foreground="#858585" FontSize="11" Margin="0,0,0,4"/>
                                <ComboBox x:Name="UpscaleComboBox" SelectedIndex="0" Style="{StaticResource ModernComboBox}" Margin="0,0,0,10">
                                    <ComboBoxItem Content="1x (Off)" Tag="1"/>
                                    <ComboBoxItem Content="2x" Tag="2"/>
                                    <ComboBoxItem Content="4x" Tag="4"/>
                                </ComboBox>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Button x:Name="PreviewEnhancementButton" Grid.Column="0" Content="Preview" Style="{StaticResource ModernButton}" Click="PreviewEnhancementButton_Click" IsEnabled="False" Margin="0,0,4,0"/>
                                    <Button x:Name="ResetEnhancementButton" Grid.Column="1" Content="Reset" Style="{StaticResource SecondaryButton}" Click="ResetEnhancementButton_Click" IsEnabled="False" Margin="4,0,0,0"/>
                                </Grid>
                                <TextBlock x:Name="EnhancementStatusText" Text="" Foreground="#007ACC" TextAlignment="Center" FontSize="10" Margin="0,0,0,5"/>
                                <Button x:Name="SaveEnhancementButton" Content="Save Enhanced" Style="{StaticResource ModernButton}" Click="SaveEnhancementButton_Click" IsEnabled="False"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox x:Name="CompressionGroupBox" Header="Compression" Style="{StaticResource ModernGroupBox}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="QualityLabel" Text="Quality" Foreground="#858585" FontSize="11" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                                    <Slider x:Name="QualitySlider" Minimum="1" Maximum="100" Value="80" ValueChanged="QualitySlider_ValueChanged"/>
                                    <TextBlock x:Name="QualityValueText" Grid.Column="1" Text="80" Foreground="#007ACC" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="EstimatedSizeText" Text="Est. Size: -" Foreground="#858585" FontSize="11" Margin="0,0,0,8"/>
                                <Button x:Name="CompressButton" Content="Compress and Save" Style="{StaticResource ModernButton}" Click="CompressButton_Click" IsEnabled="False"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox x:Name="FormatGroupBox" Header="Format" Style="{StaticResource ModernGroupBox}">
                            <StackPanel>
                                <TextBlock x:Name="TargetFormatLabel" Text="Target Format" Foreground="#858585" FontSize="11" Margin="0,0,0,4"/>
                                <ComboBox x:Name="FormatComboBox" SelectedIndex="0" Style="{StaticResource ModernComboBox}" Margin="0,0,0,10">
                                    <ComboBoxItem Content="PNG" Tag=".png"/>
                                    <ComboBoxItem Content="JPG" Tag=".jpg"/>
                                    <ComboBoxItem Content="BMP" Tag=".bmp"/>
                                </ComboBox>
                                <Button x:Name="ConvertButton" Content="Convert and Save" Style="{StaticResource ModernButton}" Click="ConvertButton_Click" IsEnabled="False"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Preview Area -->
            <Grid Grid.Column="1" Background="#1E1E1E" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
                <Border BorderBrush="#3F3F46" BorderThickness="1" Margin="20">
                    <Grid>
                        <TextBlock x:Name="PreviewHeaderText" Visibility="Collapsed"/>
                        <TextBlock x:Name="PlaceholderText" Text="Drop Image Here" Foreground="#3F3F46" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Image x:Name="ImagePreview" Stretch="Uniform" Margin="10"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#007ACC" Padding="10,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Ready" Foreground="White" VerticalAlignment="Center" FontSize="11"/>
                <TextBlock x:Name="StatusInfoText" Grid.Column="1" Text="" Foreground="White" VerticalAlignment="Center" FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</Window>
